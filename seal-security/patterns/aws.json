{
  "patterns": [
    {"name": "aws-access-key", "regex": "AKIA[0-9A-Z]{16}", "severity": "critical", "message": "AWS Access Key ID detected"},
    {"name": "aws-secret-key", "regex": "(?i)(aws_secret_access_key|aws_secret_key|secretaccesskey)[\"']?\\s*[:=]\\s*[\"']?[A-Za-z0-9/+=]{40}", "severity": "critical", "message": "AWS Secret Access Key detected"},
    {"name": "aws-session-token", "regex": "(?i)(aws_session_token|sessiontoken)[\"']?\\s*[:=]\\s*[\"']?[A-Za-z0-9/+=]{100,}", "severity": "high", "message": "AWS Session Token detected"},
    {"name": "aws-arn-master-key", "regex": "arn:aws:kms:[a-z0-9-]+:\\d{12}:key/[a-f0-9-]{36}", "severity": "high", "message": "AWS KMS key ARN — verify this is not a production key"}
  ]
}
